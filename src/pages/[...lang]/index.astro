---
import Base from '../../layouts/Base.astro';
import SkillCard from '../../components/SkillCard.astro';
import SuperteamCard from '../../components/SuperteamCard.astro';
import RepoCard from '../../components/RepoCard.astro';
import CopyBlock from '../../components/CopyBlock.astro';
import Rich from '../../components/Rich.astro';
import { registry, totalSkills, contributorCount, installCommands, SITE_URL } from '../../lib/registry';
import { i18n, localeStaticPaths } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const { m, l } = i18n(Astro);
const t = m.home;
const official = registry.official;
const featured = registry.ecosystem.filter((r) =>
  ['sendai-skills', 'solana-new', 'jupiter', 'helius', 'metaplex', 'solana-ai-kit'].includes(r.id)
);
const lead = official[0];
const leadInstall = lead ? installCommands(lead) : null;
const skillTotal = totalSkills();
const contributors = contributorCount();
const superteam = registry.superteam;
---

<Base title={t.title} description={t.description(skillTotal)}>
  <!-- ————— hero ————— -->
  <section class="hero">
    <div class="glow-orb orb-purple"></div>
    <div class="glow-orb orb-green"></div>
    <div class="container hero-inner">
      <h1 class="display">
        {t.hero.line1}<br />
        <span class="gradient-text">{t.hero.line2}</span>
      </h1>
      <p class="hero-sub">{t.hero.sub}</p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href={l('/skills')}>{t.hero.browse}</a>
        <a class="btn btn-ghost" href={l('/ecosystem')}>{t.hero.explore}</a>
      </div>
      {
        leadInstall && (
          <div class="hero-terminal">
            <CopyBlock command={leadInstall.cli} />
          </div>
        )
      }
      <dl class="hero-stats">
        <div>
          <dt>{t.stats.official}</dt>
          <dd title={t.stats.officialTip}>{official.length + superteam.length}</dd>
        </div>
        <div>
          <dt>{t.stats.ecosystem}</dt>
          <dd>{registry.ecosystem.length}</dd>
        </div>
        <div>
          <dt>{t.stats.indexed}</dt>
          <dd>{skillTotal}+</dd>
        </div>
        <div>
          <dt>{t.stats.contributors}</dt>
          <dd title={t.stats.contributorsTip}>{contributors}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ————— official skills ————— -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="section-title">{t.official.title}</h2>
          <p class="section-sub">{t.official.sub}</p>
        </div>
        <div class="section-actions">
          <a class="btn btn-ghost btn-sm" href={l('/superteam')}>{t.official.superteam}</a>
          <a class="btn btn-ghost btn-sm" href={l('/skills')}>{t.official.viewAll}</a>
        </div>
      </div>
      <div class="grid grid-official">
        {official.map((skill) => <SkillCard skill={skill} featured />)}
        {superteam.map((skill) => <SuperteamCard skill={skill} featured />)}
      </div>
    </div>
  </section>

  <!-- ————— how to use ————— -->
  <section class="section" id="use">
    <div class="container">
      <h2 class="section-title">{t.use.title}</h2>
      <p class="section-sub">
        <Rich text={t.use.sub}>
          <a slot="format" class="inline-link" href="https://agentskills.io" target="_blank" rel="noopener"
            >{t.use.formatName}</a
          >
        </Rich>
      </p>
      <div class="use-grid">
        <div class="card">
          <span class="use-step">01</span>
          <h3>{t.use.cli.title}</h3>
          <p>{t.use.cli.body}</p>
          <CopyBlock command={`npx skills add ${lead?.repo ?? 'solana-foundation/solana-dev-skill'}`} />
        </div>
        <div class="card">
          <span class="use-step">02</span>
          <h3>{t.use.manual.title}</h3>
          <p>
            <Rich text={t.use.manual.body}>
              <code slot="global" class="mono">~/.claude/skills/</code>
              <code slot="project" class="mono">.claude/skills/</code>
            </Rich>
          </p>
          <CopyBlock command={leadInstall?.claudeGlobal ?? ''} />
        </div>
        <div class="card">
          <span class="use-step">03</span>
          <h3>{t.use.noInstall.title}</h3>
          <p>{t.use.noInstall.body}</p>
          <CopyBlock prompt={false} command={t.use.noInstall.prompt(SITE_URL)} />
        </div>
      </div>
    </div>
  </section>

  <!-- ————— ecosystem teaser ————— -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="section-title">{t.ecosystem.title}</h2>
          <p class="section-sub">{t.ecosystem.sub}</p>
        </div>
        <a class="btn btn-ghost btn-sm" href={l('/ecosystem')}>{t.ecosystem.exploreAll}</a>
      </div>
      <div class="grid">
        {featured.map((repo) => <RepoCard repo={repo} expandable={false} />)}
      </div>
    </div>
  </section>

  <!-- ————— contribute ————— -->
  <section class="section">
    <div class="container">
      <div class="contribute card">
        <div class="contribute-text">
          <h2 class="section-title">{t.contribute.title}</h2>
          <p class="section-sub">
            <Rich text={t.contribute.body}>
              <code slot="code" class="mono">SKILL.md</code>
              <a
                slot="link"
                class="inline-link"
                href="https://github.com/solana-foundation/awesome-solana-ai"
                target="_blank"
                rel="noopener">awesome-solana-ai</a
              >
            </Rich>
          </p>
        </div>
        <div class="contribute-actions">
          <a
            class="btn btn-primary"
            href="https://agentskills.io"
            target="_blank"
            rel="noopener">{t.contribute.spec}</a
          >
          <a
            class="btn btn-ghost"
            href="https://github.com/solana-foundation/awesome-solana-ai"
            target="_blank"
            rel="noopener">{t.contribute.submit}</a
          >
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 110px 0 84px;
    border-bottom: 1px solid var(--border);
  }
  .orb-purple {
    width: 480px;
    height: 480px;
    top: -180px;
    left: 4%;
    background: rgba(153, 69, 255, 0.24);
  }
  .orb-green {
    width: 420px;
    height: 420px;
    top: -60px;
    right: 2%;
    background: rgba(20, 241, 149, 0.12);
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 26px;
  }
  .hero-sub {
    font-size: 1.12rem;
    color: var(--text-2);
    max-width: 58ch;
    text-wrap: pretty;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero-terminal {
    width: 100%;
    max-width: 560px;
  }
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 20px 48px;
    margin-top: 14px;
  }
  .hero-stats dt {
    font-size: 0.8rem;
    color: var(--text-3);
    order: 2;
  }
  .hero-stats dd {
    font-size: 1.9rem;
    font-weight: 660;
    letter-spacing: -0.03em;
    background: var(--gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-stats > div {
    display: flex;
    flex-direction: column;
  }
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 32px;
  }
  .grid-official {
    grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
  }
  .section-actions {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }
  .use-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 36px;
  }
  .use-step {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--green);
  }
  .use-grid .card {
    min-width: 0;
  }
  .use-grid .card p {
    display: block;
    -webkit-line-clamp: unset;
    overflow: visible;
  }
  .inline-link {
    color: var(--green);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(20, 241, 149, 0.4);
  }
  .inline-link:hover {
    text-decoration-color: var(--green);
  }
  .contribute {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 44px;
    background:
      radial-gradient(60% 120% at 90% 10%, rgba(153, 69, 255, 0.14), transparent 60%),
      var(--bg-card);
  }
  .contribute-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    flex-shrink: 0;
  }
  @media (max-width: 940px) {
    .use-grid {
      grid-template-columns: 1fr;
    }
    .grid-official {
      grid-template-columns: 1fr;
    }
    .contribute {
      flex-direction: column;
      align-items: flex-start;
      padding: 32px;
    }
  }
  @media (max-width: 640px) {
    .hero {
      padding: 72px 0 56px;
    }
    .hero-stats {
      gap: 28px;
    }
    .section-head {
      flex-wrap: wrap;
      align-items: flex-start;
    }
  }
</style>
