---
import SolanaMark from './SolanaMark.astro';
import { DEFAULT_LOCALE, i18n } from '../i18n';

const { locale, m, l } = i18n(Astro);
const f = m.common.footer;
const cols = [
  {
    title: f.browse,
    links: [
      { href: l('/skills'), label: f.officialSkills },
      { href: l('/ecosystem'), label: f.ecosystem },
      { href: '/api/skills.json', label: f.jsonIndex },
      { href: '/llms.txt', label: 'llms.txt' },
    ],
  },
  {
    title: f.foundation,
    links: [
      { href: 'https://github.com/solana-foundation', label: 'GitHub' },
      { href: 'https://github.com/solana-foundation/awesome-solana-ai', label: 'Awesome Solana AI' },
      { href: 'https://solana.com/developers', label: f.developers },
      { href: 'https://solana.com/docs', label: f.docs },
    ],
  },
  {
    title: f.learn,
    links: [
      { href: 'https://agentskills.io', label: f.agentSkillsSpec },
      { href: 'https://code.claude.com/docs/en/skills', label: f.skillsInClaudeCode },
      { href: 'https://solana.com/ai', label: 'Solana × AI' },
      { href: 'https://solana.stackexchange.com', label: 'Stack Exchange' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href={l('/')} class="brand" aria-label={m.common.brandHome}>
          <SolanaMark size={26} />
          <span>Solana <span class="thin">Skills</span></span>
        </a>
        <p>{f.blurb}</p>
      </div>
      {
        cols.map((col) => (
          <div class="footer-col">
            <h3>{col.title}</h3>
            <ul>
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.href.startsWith('http') ? '_blank' : undefined}
                    rel={link.href.startsWith('http') ? 'noopener' : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="footer-bottom">
      <span>{f.copyright(new Date().getFullYear())}</span>
      <span class="foot-sep" aria-hidden="true">·</span>
      <span>{f.licenses}</span>
      {
        locale !== DEFAULT_LOCALE && (
          <>
            <span class="foot-sep" aria-hidden="true">·</span>
            <span>{f.originalLanguage}</span>
          </>
        )
      }
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 64px 0 40px;
    margin-top: 40px;
    background: linear-gradient(180deg, transparent, rgba(153, 69, 255, 0.045));
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 40px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    font-weight: 660;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }
  .thin {
    font-weight: 420;
    color: var(--text-2);
  }
  .footer-brand p {
    margin-top: 16px;
    color: var(--text-3);
    font-size: 0.9rem;
    max-width: 34ch;
  }
  .footer-col h3 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-3);
    font-weight: 600;
    margin-bottom: 16px;
  }
  .footer-col ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer-col a {
    color: var(--text-2);
    font-size: 0.9rem;
    transition: color 0.15s ease;
  }
  .footer-col a:hover {
    color: var(--green);
  }
  .footer-bottom {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    color: var(--text-3);
    font-size: 0.82rem;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 540px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
