---
import CopyBlock from '../CopyBlock.astro';
import { kitEntry } from '../../lib/registry';
import { i18n } from '../../i18n';

// The Solana AI Kit, for the foot of every Superteam Brasil page: the skills
// here ship with it, so each page points at the whole kit.
interface Props {
  /** Lead sentence; defaults to the generic one. */
  lead?: string;
}
const { m, l } = i18n(Astro);
const t = m.superteam.kitBand;
const kit = kitEntry();
const s = kit?.stats;
const { lead = t.lead } = Astro.props;
---

{
  kit && s && (
    <section class="st-kit" aria-labelledby="kit-band-title">
      <span class="badge badge-st">Solana AI Kit {kit.tag ?? `v${s.version}`}</span>
      <h2 id="kit-band-title" style="margin-top:14px">{t.heading}</h2>
      <p>
        {t.body(lead, s)}
      </p>
      <dl class="st-stats">
        <div><dt>{t.agents}</dt><dd>{s.agents}</dd></div>
        <div><dt>{t.commands}</dt><dd>{s.commands}</dd></div>
        <div><dt>{t.packs}</dt><dd>{s.packs}</dd></div>
        <div><dt>{t.mcpServers}</dt><dd>{s.mcpServers}</dd></div>
      </dl>
      {kit.install && <CopyBlock command={kit.install} />}
      <div class="st-kit-actions">
        <a class="btn btn-primary btn-sm" href={kit.url} target="_blank" rel="noopener">{t.github}</a>
        <a class="btn btn-ghost btn-sm" href={l('/superteam')}>{t.allSkills}</a>
      </div>
    </section>
  )
}
