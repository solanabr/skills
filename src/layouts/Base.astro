---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { DEFAULT_LOCALE, LOCALES, LOCALE_META, alternates, i18n } from '../i18n';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  /** Page-specific social card (site-relative), defaults to the generic one. */
  ogImage?: string;
  /** Locale-free path the language switcher links to, for a page with no
   *  per-language twin of its own (the 404). */
  langPath?: string;
}

const { title, description, canonical, noindex = false, ogImage, langPath } = Astro.props;
const { locale, tag, m } = i18n(Astro);
// build.format 'file' makes pathname end in .html — canonicals must match the
// extensionless URLs the site links and the sitemap advertise.
const cleanPath =
  Astro.url.pathname.replace(/\.html$/, "").replace(/^\/index$/, "/") || "/";
const canonicalURL = canonical ?? new URL(cleanPath, Astro.site).href;
const ogImageURL = new URL(ogImage ?? '/og/home.png', Astro.site).href;
// Every page exists in every language, so each one lists all of them (and the
// English page as x-default) — except pages kept out of the index.
const languages = noindex ? [] : alternates(Astro.url.pathname, Astro.site);
const defaultLanguage = languages.find((alt) => alt.locale === DEFAULT_LOCALE);
---

<!doctype html>
<html lang={tag}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalURL} />
    {languages.map((alt) => <link rel="alternate" hreflang={alt.tag} href={alt.href} />)}
    {defaultLanguage && <link rel="alternate" hreflang="x-default" href={defaultLanguage.href} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#000000" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Solana Skills" />
    <meta property="og:locale" content={LOCALE_META[locale].og} />
    {
      LOCALES.filter((other) => other !== locale).map((other) => (
        <meta property="og:locale:alternate" content={LOCALE_META[other].og} />
      ))
    }
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <link rel="alternate" type="application/json" href="/api/skills.json" title="Skills index" />
    <slot name="head" />
  </head>
  <body
    data-copied={m.common.copy.copied}
    data-failed={m.common.copy.mdFailed}
    data-locale-prefix={locale === DEFAULT_LOCALE ? undefined : `/${locale}`}
  >
    <a class="skip-link" href="#main">{m.common.skipToContent}</a>
    <Header langPath={langPath} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Button feedback text comes from the page's language (data attributes on
      // <body>). A label's own text is remembered the first time, so a second
      // click mid-flash can't leave it stuck on "Copied".
      const words = document.body.dataset;
      const remember = (el: Element) => ((el as HTMLElement).dataset.label ??= el.textContent ?? '');

      // Links to site pages inside mirrored skill markdown are compiled once, in
      // English; on a translated page, keep the reader in their language.
      if (words.localePrefix) {
        document.querySelectorAll<HTMLAnchorElement>('#skill-prose a[href^="/superteam"]').forEach((a) => {
          a.setAttribute('href', words.localePrefix + a.getAttribute('href'));
        });
      }

      // Copy-to-clipboard: any element with [data-copy]
      document.addEventListener('click', async (e) => {
        const target = e.target as HTMLElement;
        const btn = target.closest<HTMLElement>('[data-copy]');
        if (!btn) return;
        const text = btn.getAttribute('data-copy') ?? '';
        try {
          await navigator.clipboard.writeText(text);
          btn.classList.add('copied');
          const label = btn.querySelector('.copy-label');
          if (label) {
            remember(label);
            label.textContent = words.copied ?? 'Copied';
          }
          setTimeout(() => {
            btn.classList.remove('copied');
            if (label) label.textContent = (label as HTMLElement).dataset.label ?? 'Copy';
          }, 1600);
        } catch {
          /* clipboard unavailable */
        }
      });

      // Copy a file's contents: any element with [data-copy-url]. The fetch is
      // handed to ClipboardItem as a promise, which keeps Safari's user-gesture
      // requirement satisfied; writeText is the fallback elsewhere.
      document.addEventListener('click', async (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-copy-url]');
        if (!btn) return;
        const url = btn.getAttribute('data-copy-url') ?? '';
        const label = btn.querySelector('.md-label');
        if (label) remember(label);
        const flash = (cls: string, text: string) => {
          btn.classList.add(cls);
          if (label) label.textContent = text;
          setTimeout(() => {
            btn.classList.remove(cls);
            if (label) label.textContent = (label as HTMLElement).dataset.label ?? 'Copy .md';
          }, 1600);
        };
        const text = fetch(url).then((r) => {
          if (!r.ok) throw new Error(String(r.status));
          return r.text();
        });
        try {
          if (window.ClipboardItem && navigator.clipboard.write) {
            await navigator.clipboard.write([
              new ClipboardItem({ 'text/plain': text.then((t) => new Blob([t], { type: 'text/plain' })) }),
            ]);
          } else {
            await navigator.clipboard.writeText(await text);
          }
          flash('copied', words.copied ?? 'Copied');
        } catch {
          flash('failed', words.failed ?? 'Copy failed');
        }
      });

      // Tabs: [role=tab] toggling sibling [role=tabpanel]s within a [data-tabs] scope
      function activateTab(tab: HTMLElement) {
        const scope = tab.closest<HTMLElement>('[data-tabs]');
        if (!scope) return;
        const id = tab.getAttribute('data-tab');
        scope.querySelectorAll<HTMLElement>('[role="tab"]').forEach((t) => {
          t.setAttribute('aria-selected', String(t === tab));
          t.tabIndex = t === tab ? 0 : -1;
        });
        scope.querySelectorAll<HTMLElement>('[role="tabpanel"]').forEach((p) => {
          p.hidden = p.getAttribute('data-panel') !== id;
        });
      }
      document.addEventListener('click', (e) => {
        const tab = (e.target as HTMLElement).closest<HTMLElement>('[role="tab"]');
        if (tab) activateTab(tab);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        const tab = (e.target as HTMLElement).closest?.<HTMLElement>('[role="tab"]');
        if (!tab) return;
        const tabs = Array.from(
          tab.closest('[role="tablist"]')?.querySelectorAll<HTMLElement>('[role="tab"]') ?? []
        );
        const i = tabs.indexOf(tab);
        const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        if (next) {
          next.focus();
          activateTab(next);
          e.preventDefault();
        }
      });
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 12px;
        z-index: 100;
        background: var(--green);
        color: #000;
        padding: 10px 18px;
        border-radius: 999px;
        font-weight: 600;
      }
      .skip-link:focus {
        left: 12px;
      }
    </style>
  </body>
</html>
