---
import Base from '../../../layouts/Base.astro';
import MdActions from '../../../components/MdActions.astro';
import KitBand from '../../../components/superteam/KitBand.astro';
import '../../../styles/superteam.css';
import { registry, kitEntry, superteamPage, superteamFileUrl } from '../../../lib/registry';
import { i18n, localeStaticPaths } from '../../../i18n';

export const getStaticPaths = localeStaticPaths;

const { m, l } = i18n(Astro);
const t = m.superteam.index;
const skills = registry.superteam;
const kit = kitEntry();
const people = new Set([...skills, ...(kit ? [kit] : [])].flatMap((e) => e.contributors ?? [])).size;
const subskillCount = skills.reduce((n, s) => n + s.subskills.length, 0);
const fileCount = skills.reduce((n, s) => n + s.files.length, 0);
const kindCount: Record<string, ((n: number) => string) | undefined> = t.kinds;
const kindsOf = (s: (typeof skills)[number]) =>
  Object.entries(
    s.subskills.reduce<Record<string, number>>((acc, x) => ((acc[x.kind] = (acc[x.kind] ?? 0) + 1), acc), {}),
  ).map(([k, n]) => kindCount[k]?.(n) ?? `${n} ${k}`);
---

<Base
  title={t.title}
  description={t.description}
  ogImage="/og/superteam.png"
>
  <section class="st-head st-hero">
    <div class="container">
      <div class="st-badges">
        <span class="badge badge-st">Superteam Brasil</span>
        <span class="badge">{t.officialSkills}</span>
      </div>
      <h1 class="display st-title">
        {t.heading}<br /><span class="gradient-text">Superteam Brasil</span>
      </h1>
      <p class="st-lead">{t.lead}</p>
      <dl class="st-stats">
        <div><dt>{t.stats.skills}</dt><dd>{skills.length}</dd></div>
        <div><dt>{t.stats.subskills}</dt><dd>{subskillCount}</dd></div>
        <div><dt>{t.stats.files}</dt><dd>{fileCount}</dd></div>
        <div><dt>{t.stats.contributors}</dt><dd>{people}</dd></div>
      </dl>
    </div>
  </section>

  <section class="st-body">
    <div class="container">
      <div class="st-feature-grid">
        {
          skills.map((s) => (
            <article class="st-feature">
              <div class="st-badges" style="margin:0">
                <span class="badge badge-st">Superteam Brasil</span>
                {s.tag && <span class="badge">{s.tag}</span>}
                <span class="badge">{s.kitTier === 'core' ? t.corePack : t.addOnPack}</span>
              </div>
              <h3>
                <a href={l(superteamPage(s))}>{s.displayName}</a>
              </h3>
              <p>{s.tagline}</p>
              <div class="st-chips">
                {kindsOf(s).map((k) => (
                  <span>{k}</span>
                ))}
                {s.counts.checklists ? <span>{t.checklists(s.counts.checklists)}</span> : null}
                {s.counts.knownVectors ? <span>{t.knownVectors(s.counts.knownVectors)}</span> : null}
                {s.counts.references ? <span>{t.references(s.counts.references)}</span> : null}
                {s.stars !== null && <span>★ {s.stars}</span>}
              </div>
              <div class="st-kit-actions" style="margin-top:4px">
                <a class="btn btn-primary btn-sm" href={l(superteamPage(s))}>
                  {t.explore(s.displayName)}
                </a>
                {s.main && <MdActions url={superteamFileUrl(s, s.main)} name={`${s.displayName} ${s.main}`} />}
              </div>
            </article>
          ))
        }
      </div>

      {
        skills.map((s) => (
          <section>
            <div class="st-section-title st-section-head">
              <h2>{s.displayName}</h2>
              <a class="btn btn-ghost btn-sm" href={l(superteamPage(s))}>{t.open}</a>
            </div>
            <p class="st-section-sub">{s.summary}</p>
            <div class="st-cards">
              {s.subskills.map((x) => (
                <div class="st-card">
                  <a class="st-card-main" href={l(superteamPage(s, x))}>
                    <span class="st-card-name">{x.name}</span>
                    {x.description && <span class="st-card-desc">{x.description}</span>}
                  </a>
                  <MdActions url={superteamFileUrl(s, x.path)} name={x.name} size="sm" />
                </div>
              ))}
            </div>
          </section>
        ))
      }

      <KitBand />
    </div>
  </section>
</Base>
