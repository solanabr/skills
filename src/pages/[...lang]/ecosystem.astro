---
import Base from '../../layouts/Base.astro';
import RepoCard from '../../components/RepoCard.astro';
import Rich from '../../components/Rich.astro';
import { registry } from '../../lib/registry';
import { i18n, localeStaticPaths } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const { m, l } = i18n(Astro);
const t = m.ecosystem;

const groups: { title: string; sub: string; types: string[] }[] = [
  { ...t.groups.toolkits, types: ['aggregator', 'toolkit'] },
  { ...t.groups.vendors, types: ['vendor'] },
  { ...t.groups.community, types: ['community'] },
];

const byTypes = (types: string[]) => registry.ecosystem.filter((r) => types.includes(r.type));
const skillSum = registry.ecosystem.reduce((n, r) => n + r.skills.length, 0);
// The badge on a Foundation resource: translated when the kind is a known one.
const kindLabel = (kind: string) => (t.foundation.kinds as Record<string, string>)[kind] ?? kind;
---

<Base
  title={t.title}
  description={t.description(registry.ecosystem.length, skillSum)}
  ogImage="/og/ecosystem.png"
>
  <section class="section eco-head">
    <div class="container">
      <h1 class="section-title">{t.head.title}</h1>
      <p class="section-sub">
        <Rich text={t.head.sub(skillSum, registry.ecosystem.length)}>
          <a
            slot="link"
            class="inline-link"
            href="https://github.com/solana-foundation/awesome-solana-ai"
            target="_blank"
            rel="noopener">awesome-solana-ai</a
          >
        </Rich>
      </p>
    </div>
  </section>

  <section class="eco-group">
    <div class="container">
      <h2 class="group-title">{t.foundation.title}</h2>
      <p class="group-sub muted">{t.foundation.sub}</p>
      <div class="grid resources">
        {
          registry.foundationResources.map((res) => (
            <a class="card" href={res.url} target="_blank" rel="noopener">
              <svg
                class="card-arrow"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 17 17 7M7 7h10v10" />
              </svg>
              <div class="res-head">
                <img
                  class="res-logo"
                  src={`/logos/${res.repo.split('/')[0]}.png`}
                  alt=""
                  width="20"
                  height="20"
                  loading="lazy"
                />
                <span class="badge badge-official">{m.common.official}</span>
                <span class="badge">{kindLabel(res.kind)}</span>
              </div>
              <h3>{res.name}</h3>
              <code class="mono res-repo">{res.repo}</code>
              <p>{res.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {
    groups.map((group) => {
      const repos = byTypes(group.types);
      return (
        repos.length > 0 && (
          <section class="eco-group">
            <div class="container">
              <h2 class="group-title">{group.title}</h2>
              <p class="group-sub muted">{group.sub}</p>
              <div class="grid">
                {repos.map((repo) => (
                  <RepoCard repo={repo} />
                ))}
              </div>
            </div>
          </section>
        )
      );
    })
  }

  <section class="eco-group">
    <div class="container">
      <h2 class="group-title">{t.tail.title}</h2>
      <p class="group-sub muted">
        <Rich text={t.tail.sub}>
          <a
            slot="link"
            class="inline-link"
            href="https://github.com/solana-foundation/awesome-solana-ai"
            target="_blank"
            rel="noopener">awesome-solana-ai</a
          >
        </Rich>
      </p>
      <ul class="tail-list">
        {
          registry.communityIndex.map((entry) => (
            <li>
              <a href={`https://github.com/${entry.repo}`} target="_blank" rel="noopener">
                {entry.logo && (
                  <img class="tail-logo" src={entry.logo} alt="" width="18" height="18" loading="lazy" />
                )}
                <span class="tail-name">{entry.name}</span>
                <code class="mono tail-repo">{entry.repo}</code>
                <span class="tail-desc muted">{entry.description}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="disclaimer muted">
        <p>
          <strong>{t.disclaimer.criteria.lead}</strong>{' '}
          <Rich text={t.disclaimer.criteria.body}>
            <a
              slot="link"
              class="inline-link"
              href="https://github.com/solana-foundation/awesome-solana-ai"
              target="_blank"
              rel="noopener">awesome-solana-ai</a
            >
            <code slot="file" class="mono">SKILL.md</code>
            <code slot="field" class="mono">name</code>
          </Rich>
        </p>
        <p>
          <strong>{t.disclaimer.trust.lead}</strong>{' '}
          <Rich text={t.disclaimer.trust.body}>
            <code slot="hash" class="mono">sha256</code>
            <code slot="check" class="mono">curl | shasum -a 256</code>
            <a slot="json" class="inline-link" href={l('/api/skills.json')}>skills.json</a>
            <code slot="install" class="mono">npx skills add</code>
          </Rich>
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card add-repo">
        <div>
          <h2>{t.add.title}</h2>
          <p class="muted">
            <Rich text={t.add.body}>
              <code slot="repo" class="mono">awesome-solana-ai</code>
            </Rich>
          </p>
        </div>
        <a
          class="btn btn-primary"
          href="https://github.com/solana-foundation/awesome-solana-ai"
          target="_blank"
          rel="noopener">{t.add.cta}</a
        >
      </div>
    </div>
  </section>
</Base>

<style>
  .eco-head {
    padding-bottom: 24px;
    background:
      radial-gradient(50% 90% at 85% 0%, rgba(20, 241, 149, 0.08), transparent 60%),
      radial-gradient(40% 80% at 10% 0%, rgba(153, 69, 255, 0.12), transparent 60%),
      var(--bg);
  }
  .inline-link {
    color: var(--green);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(20, 241, 149, 0.4);
  }
  .eco-group {
    padding-block: 28px;
  }
  .res-head {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .res-logo {
    border-radius: 5px;
    object-fit: cover;
    background: var(--bg-elev);
  }
  .res-repo {
    font-size: 0.76rem;
    color: var(--text-3);
  }
  .resources .card p {
    -webkit-line-clamp: 4;
  }
  .tail-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(460px, 1fr));
    gap: 4px 24px;
  }
  .tail-list li a {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 9px 12px;
    border-radius: 10px;
    transition: background 0.12s ease;
    min-width: 0;
  }
  .tail-logo {
    border-radius: 5px;
    object-fit: cover;
    background: var(--bg-elev);
    align-self: center;
    flex-shrink: 0;
  }
  .tail-list li a:hover {
    background: rgba(255, 255, 255, 0.05);
  }
  .tail-name {
    font-weight: 570;
    font-size: 0.9rem;
    white-space: nowrap;
  }
  .tail-repo {
    font-size: 0.74rem;
    color: var(--text-3);
    white-space: nowrap;
  }
  .tail-desc {
    font-size: 0.82rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tail-list li a:hover .tail-name {
    color: var(--green);
  }
  .disclaimer {
    margin-top: 28px;
    font-size: 0.8rem;
    line-height: 1.6;
    max-width: 88ch;
    padding: 14px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elev);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .disclaimer strong {
    color: var(--text-2);
  }
  @media (max-width: 560px) {
    .tail-list {
      grid-template-columns: 1fr;
    }
    .tail-list li a {
      flex-wrap: wrap;
      gap: 4px 10px;
    }
  }
  .group-title {
    font-size: 1.25rem;
  }
  .group-sub {
    margin: 6px 0 22px;
    font-size: 0.92rem;
  }
  .add-repo {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 36px;
  }
  .add-repo h2 {
    font-size: 1.3rem;
    margin-bottom: 8px;
  }
  .add-repo p {
    display: block;
    -webkit-line-clamp: unset;
    overflow: visible;
  }
  @media (max-width: 720px) {
    .add-repo {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
