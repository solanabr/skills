---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import CopyBlock from '../../../components/CopyBlock.astro';
import MdActions from '../../../components/MdActions.astro';
import KitBand from '../../../components/superteam/KitBand.astro';
import FileLibrary from '../../../components/superteam/FileLibrary.astro';
import '../../../styles/superteam.css';
import {
  registry,
  SITE_URL,
  superteamPage,
  superteamFileUrl,
  superteamGithubUrl,
} from '../../../lib/registry';

export async function getStaticPaths() {
  const entries = await getCollection('stbr');
  return registry.superteam.flatMap((skill) =>
    skill.subskills.map((sub) => ({
      params: { id: skill.id, sub: sub.slug },
      props: { skill, sub, entry: entries.find((e) => e.id === `${skill.id}/${sub.path.replace(/\.md$/, '')}`) },
    })),
  );
}

const { skill, sub, entry } = Astro.props;
const { Content } = entry ? await render(entry) : { Content: null };
const fileUrl = superteamFileUrl(skill, sub.path);
const KIND_LABEL: Record<string, string> = { skill: 'Skill', command: 'Command', agent: 'Agent' };
const siblings = skill.subskills.filter((x) => x.kind === sub.kind);
const i = siblings.findIndex((x) => x.slug === sub.slug);
const prev = i > 0 ? siblings[i - 1] : null;
const next = i < siblings.length - 1 ? siblings[i + 1] : null;
const dirName = sub.slug.split('/').pop() ?? sub.name;
// How to use this one piece. Commands and agents come with the plugin or the
// kit; a skill can be taken on its own, pinned to the indexed commit.
const pinnedSkill =
  sub.kind === 'skill' && skill.commitSha
    ? 'mkdir -p .claude/skills/' + dirName + ' && curl -fsSL https://codeload.github.com/' + skill.repo + '/tar.gz/' + skill.commitSha +
      ' | tar -xz -C .claude/skills/' + dirName + ' --strip-components=' + (sub.slug.split('/').length + 1) + ' ' +
      skill.repo.split('/')[1] + '-' + skill.commitSha + '/' + sub.slug
    : null;
const metaDesc = (sub.description ?? skill.tagline).slice(0, 158);
---

<Base
  title={`${sub.name} · ${skill.displayName} by Superteam Brasil`}
  description={metaDesc}
  ogImage={`/og/superteam/${skill.id}/${sub.slug}.png`}
>
  <section class="st-head">
    <div class="container">
      <nav class="st-breadcrumb" aria-label="Breadcrumb">
        <a href="/superteam">Superteam Brasil</a>
        <span aria-hidden="true">/</span>
        <a href={superteamPage(skill)}>{skill.displayName}</a>
        <span aria-hidden="true">/</span>
        <span>{sub.name}</span>
      </nav>
      <div class="st-badges">
        <span class="badge badge-st">Superteam Brasil · Official</span>
        <span class="badge">{KIND_LABEL[sub.kind]}</span>
        <span class="badge">{skill.displayName}</span>
      </div>
      <h1 class="st-title mono">{sub.name}</h1>
      <div class="st-byline">
        <span>by Superteam Brasil</span>
        <span aria-hidden="true">·</span>
        <a href={superteamGithubUrl(skill, sub.path)} target="_blank" rel="noopener">{skill.repo}/{sub.path}</a>
      </div>
      {sub.description && <p class="st-lead">{sub.description}</p>}
      <div style="margin-top:20px">
        <MdActions url={fileUrl} name={sub.name} />
      </div>
    </div>
  </section>

  <section class="st-body">
    <div class="container st-grid">
      <article>
        <div class="st-panel">
          {
            sub.kind === 'command' && (
              <>
                <p class="st-panel-note">
                  Run it in Claude Code once {skill.displayName} is installed (plugin, script or the
                  Solana AI Kit; see <a href={superteamPage(skill)}>{skill.displayName}</a>):
                </p>
                <CopyBlock command={`/${sub.name}`} prompt={false} />
              </>
            )
          }
          {
            sub.kind === 'agent' && (
              <p class="st-panel-note">
                A subagent of {skill.displayName}: its commands spawn it, so it comes with any install
                of the skill (see <a href={superteamPage(skill)}>{skill.displayName}</a>).
              </p>
            )
          }
          {
            sub.kind === 'skill' && pinnedSkill && (
              <>
                <p class="st-panel-note">
                  Just this skill, with its reference files, at the pinned commit:
                </p>
                <CopyBlock command={pinnedSkill} />
                <p class="st-panel-note">
                  Or the whole set. The skills link to each other's format files, so the set works
                  best together:
                </p>
                {skill.install[0]?.commands.map((c) => <CopyBlock command={c} />)}
              </>
            )
          }
          <p class="st-panel-note">No install: tell your agent</p>
          <CopyBlock command={`Read ${SITE_URL}${fileUrl} and follow it for this task: `} prompt={false} />
        </div>

        <div class="st-section-title st-section-head">
          <h2>{sub.path.split('/').pop()}</h2>
          <MdActions url={fileUrl} name={sub.path} />
        </div>
        {
          Content ? (
            <div class="prose" id="skill-prose">
              <Content />
            </div>
          ) : (
            <p class="muted">
              This file is not mirrored yet. <a href={superteamGithubUrl(skill, sub.path)} target="_blank" rel="noopener">Read it on GitHub</a>.
            </p>
          )
        }

        <nav class="st-kit-actions" aria-label={`Other ${KIND_LABEL[sub.kind].toLowerCase()}s`} style="margin-top:40px">
          {prev && <a class="btn btn-ghost btn-sm" href={superteamPage(skill, prev)}>← {prev.name}</a>}
          {next && <a class="btn btn-ghost btn-sm" href={superteamPage(skill, next)}>{next.name} →</a>}
        </nav>

        <KitBand />
      </article>

      <aside class="st-aside">
        <div class="st-meta">
          <h3>Details</h3>
          <dl>
            <div><dt>Part of</dt><dd><a href={superteamPage(skill)}>{skill.displayName}</a></dd></div>
            <div><dt>Type</dt><dd>{KIND_LABEL[sub.kind]}</dd></div>
            <div><dt>Maintainer</dt><dd>Superteam Brasil</dd></div>
            <div><dt>License</dt><dd>{skill.license ?? 'None declared'}</dd></div>
            {skill.tag && <div><dt>Release</dt><dd>{skill.tag}</dd></div>}
            <div>
              <dt>Pinned commit</dt>
              <dd><a class="mono" href={superteamGithubUrl(skill, sub.path)} target="_blank" rel="noopener">{skill.commitSha?.slice(0, 7)}</a></dd>
            </div>
          </dl>
        </div>
        {
          sub.files.length > 0 && (
            <div class="st-meta">
              <h3>Reference files ({sub.files.length})</h3>
              <FileLibrary skill={skill} paths={sub.files} base={sub.slug + '/'} open />
            </div>
          )
        }
        <div class="st-meta">
          <h3>More {KIND_LABEL[sub.kind].toLowerCase()}s ({siblings.length})</h3>
          <div class="st-files">
            <ul>
              {siblings.map((x) => (
                <li>
                  <a href={superteamPage(skill, x)} aria-current={x.slug === sub.slug ? 'page' : undefined}>{x.name}</a>
                  <button type="button" class="st-file-copy" data-copy-url={superteamFileUrl(skill, x.path)} aria-label={`Copy ${x.name} as Markdown`}>
                    <span class="md-label">Copy .md</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </section>
</Base>
