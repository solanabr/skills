---
import CopyBlock from '../CopyBlock.astro';
import type { InstallOption } from '../../lib/registry';
import { i18n } from '../../i18n';

interface Props {
  options: InstallOption[];
  /** Absolute URL of the hosted .md, for the "No install" tab. */
  fetchable?: string | null;
}
const { options, fetchable } = Astro.props;
const { m } = i18n(Astro);
const msg = m.superteam;
// Each option carries its own English label and note from the registry. Those
// the site ships are translated (matched on the exact English text); anything
// else shows as the registry wrote it.
const known = (map: Record<string, string>, text: string) => (Object.hasOwn(map, text) ? map[text] : text);
const tabs = [
  ...options.map((o, i) => ({
    key: `opt${i}`,
    ...o,
    label: known(msg.install.labels, o.label),
    note: known(msg.install.notes, o.note),
  })),
  ...(fetchable
    ? [
        {
          key: 'noinstall',
          label: msg.install.noInstall,
          note: msg.install.noInstallNote,
          commands: [msg.readPrompt(fetchable)],
          prompt: false,
        },
      ]
    : []),
];
---

<div class="st-panel" data-tabs>
  <div class="tabs" role="tablist" aria-label={msg.install.methods}>
    {
      tabs.map((t, i) => (
        <button
          class="tab"
          role="tab"
          id={`tab-${t.key}`}
          aria-controls={`panel-${t.key}`}
          data-tab={t.key}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? undefined : '-1'}
        >
          {t.label}
        </button>
      ))
    }
  </div>
  {
    tabs.map((t, i) => (
      <div
        class="tab-panel"
        role="tabpanel"
        id={`panel-${t.key}`}
        aria-labelledby={`tab-${t.key}`}
        tabindex="0"
        data-panel={t.key}
        hidden={i !== 0}
      >
        <p class="st-panel-note">{t.note}</p>
        {t.commands.map((c) => (
          <CopyBlock command={c} prompt={t.prompt !== false} />
        ))}
      </div>
    ))
  }
</div>
