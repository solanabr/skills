---
import type { EcosystemRepo } from '../lib/registry';
import { registry, repoInstallCommand, ecoSkillPage } from '../lib/registry';
import { i18n } from '../i18n';

interface Props {
  repo: EcosystemRepo;
  expandable?: boolean;
}
const { repo, expandable = true } = Astro.props;
const { m, l, num, date } = i18n(Astro);
const t = m.repoCard;

const TYPE_LABELS: Record<string, string> = {
  ...t.types,
  vendor: repo.vendor,
};
const initial = repo.displayName.replace(/^[^a-zA-Z0-9]*/, '').charAt(0).toUpperCase();
const install = repoInstallCommand(repo);
// 8085 → '8.1k', with the language's own decimal mark ('8,1k').
const decimalMark = num(1.5).replace(/\d/g, '');
const fmtStars = (n: number) =>
  n >= 1000 ? `${(n / 1000).toFixed(1).replace('.', decimalMark)}k` : String(n);
const daysSincePush = repo.pushedAt
  ? Math.floor((Date.parse(registry.updated) - Date.parse(repo.pushedAt)) / 86_400_000)
  : null;
const pushedLabel = repo.pushedAt ? date(repo.pushedAt, { month: 'short', year: 'numeric' }) : null;
const pushedTip = repo.pushedAt ? t.lastPush(repo.pushedAt) : undefined;
const staleDays = daysSincePush !== null && daysSincePush > 180 ? daysSincePush : null;
const countLabel = repo.highlightsOnly ? t.picks(repo.skills.length, repo.skillCount) : t.skills(repo.skills.length);
---

<article class="card hoverable repo-card" id={repo.id}>
  <header class="repo-head">
    {
      repo.logo ? (
        <img class="avatar avatar-img" src={repo.logo} alt="" width="42" height="42" loading="lazy" />
      ) : (
        <div class="avatar" aria-hidden="true">
          {initial}
        </div>
      )
    }
    <div class="repo-id">
      <h3>{repo.displayName}</h3>
      <a class="mono repo-slug" href={repo.url} target="_blank" rel="noopener">{repo.repo}</a>
    </div>
    <span class:list={['badge', { 'badge-vendor': repo.type === 'vendor' }]}>
      {TYPE_LABELS[repo.type]}
    </span>
  </header>
  <p class="repo-blurb">{repo.blurb}</p>
  <div class="card-meta">
    <span>{countLabel}</span>
    {repo.stars !== null && <span aria-hidden="true">·</span>}
    {
      repo.stars !== null && (
        <span title={t.stars}>
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
            style="display:inline;vertical-align:-1px"
          >
            <path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2Z" />
          </svg>
          {fmtStars(repo.stars)}
        </span>
      )
    }
    {
      pushedLabel && (
        <>
          <span aria-hidden="true">·</span>
          <span title={pushedTip}>{pushedLabel}</span>
        </>
      )
    }
    {
      repo.license && (
        <>
          <span aria-hidden="true">·</span>
          <span>{repo.license}</span>
        </>
      )
    }
    {
      repo.tag && (
        <>
          <span aria-hidden="true">·</span>
          <span title={t.release}>{repo.tag}</span>
        </>
      )
    }
    {
      repo.commitSha && (
        <>
          <span aria-hidden="true">·</span>
          <a
            class="mono sha-pin"
            href={`https://github.com/${repo.repo}/tree/${repo.commitSha}`}
            target="_blank"
            rel="noopener"
            title={t.pin}
          >
            @ {repo.commitSha.slice(0, 7)}
          </a>
        </>
      )
    }
    {
      staleDays !== null && (
        <span class="stale-badge" title={t.staleTip(staleDays)}>
          {t.stale}
        </span>
      )
    }
  </div>
  {
    expandable && repo.skills.length > 0 && (
      <details class="skill-list">
        <summary>
          {repo.highlightsOnly ? t.highlights : t.browse}
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <ul>
          {repo.skills.map((s) => {
            const page = ecoSkillPage(repo, s);
            return (
              <li>
                <a
                  href={page ? l(page) : s.url}
                  target={page ? undefined : '_blank'}
                  rel={page ? undefined : 'noopener'}
                  title={s.description}
                >
                  <code class="mono">{s.name}</code>
                  <span class="skill-desc">{s.description}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </details>
    )
  }
  <div class="repo-actions">
    <div class="copyblock mini">
      <span class="cmd"><span class="prompt-char">$ </span>{install}</span>
      <button class="copy-btn" data-copy={install} aria-label={t.copyInstall(repo.displayName)} title={m.common.copy.copy}>
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="9" y="9" width="13" height="13" rx="2" />
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
        </svg>
      </button>
    </div>
    <a class="btn btn-ghost btn-sm" href={repo.url} target="_blank" rel="noopener">GitHub</a>
    {
      repo.homepage && (
        <a class="btn btn-ghost btn-sm" href={repo.homepage} target="_blank" rel="noopener">
          {t.site}
        </a>
      )
    }
  </div>
</article>

<style>
  .repo-card {
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  .repo-head {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .avatar {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 12px;
    font-weight: 700;
    font-size: 1.05rem;
    color: #fff;
    background: linear-gradient(135deg, rgba(153, 69, 255, 0.85), rgba(20, 241, 149, 0.55));
  }
  .avatar-img {
    object-fit: cover;
    background: var(--bg-elev);
    border: 1px solid var(--border);
  }
  .repo-id {
    flex: 1;
    min-width: 0;
  }
  .repo-id h3 {
    font-size: 1.02rem;
  }
  .repo-slug {
    display: block;
    font-size: 0.76rem;
    color: var(--text-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .repo-slug:hover {
    color: var(--green);
  }
  .repo-blurb {
    -webkit-line-clamp: 4 !important;
  }
  .sha-pin {
    font-size: 0.74rem;
    color: var(--text-3);
    border: 1px dashed var(--border-strong);
    border-radius: 6px;
    padding: 1px 7px;
    transition: color 0.12s ease, border-color 0.12s ease;
  }
  .sha-pin:hover {
    color: var(--green);
    border-color: rgba(20, 241, 149, 0.5);
  }
  .stale-badge {
    font-size: 0.68rem;
    font-weight: 640;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #f5b544;
    border: 1px solid rgba(245, 181, 68, 0.35);
    border-radius: 999px;
    padding: 1px 8px;
  }
  .skill-list {
    border-top: 1px solid var(--border);
    padding-top: 12px;
  }
  .skill-list summary {
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 560;
    color: var(--text-2);
    list-style: none;
    user-select: none;
  }
  .skill-list summary::-webkit-details-marker {
    display: none;
  }
  .skill-list summary:hover {
    color: var(--green);
  }
  .skill-list[open] summary svg {
    transform: rotate(180deg);
  }
  .skill-list ul {
    list-style: none;
    padding: 12px 0 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    max-height: 300px;
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .skill-list li a {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 6px 8px;
    border-radius: 8px;
    transition: background 0.12s ease;
  }
  .skill-list li a:hover {
    background: rgba(255, 255, 255, 0.05);
  }
  .skill-list li code {
    font-size: 0.78rem;
    color: var(--green);
    white-space: nowrap;
  }
  .skill-desc {
    font-size: 0.78rem;
    color: var(--text-3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .repo-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 2px;
  }
  .copyblock.mini {
    flex: 1;
    min-width: 0;
    padding: 4px 4px 4px 12px;
    font-size: 0.76rem;
  }
</style>
