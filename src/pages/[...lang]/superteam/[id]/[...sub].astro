---
import { getCollection, render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import CopyBlock from '../../../../components/CopyBlock.astro';
import MdActions from '../../../../components/MdActions.astro';
import Rich from '../../../../components/Rich.astro';
import KitBand from '../../../../components/superteam/KitBand.astro';
import FileLibrary from '../../../../components/superteam/FileLibrary.astro';
import '../../../../styles/superteam.css';
import {
  registry,
  SITE_URL,
  superteamPage,
  superteamFileUrl,
  superteamGithubUrl,
} from '../../../../lib/registry';
import { i18n, withLocales } from '../../../../i18n';

export async function getStaticPaths() {
  const entries = await getCollection('stbr');
  return withLocales(
    registry.superteam.flatMap((skill) =>
      skill.subskills.map((sub) => ({
        params: { id: skill.id, sub: sub.slug },
        props: { skill, sub, entry: entries.find((e) => e.id === `${skill.id}/${sub.path.replace(/\.md$/, '')}`) },
      })),
    ),
  );
}

const { skill, sub, entry } = Astro.props;
const { m, l, tx } = i18n(Astro);
const t = m.superteam.sub;
const d = m.superteam.detail;
const { Content } = entry ? await render(entry) : { Content: null };
const fileUrl = superteamFileUrl(skill, sub.path);
const siblings = skill.subskills.filter((x) => x.kind === sub.kind);
const i = siblings.findIndex((x) => x.slug === sub.slug);
const prev = i > 0 ? siblings[i - 1] : null;
const next = i < siblings.length - 1 ? siblings[i + 1] : null;
const dirName = sub.slug.split('/').pop() ?? sub.name;
// How to use this one piece. Commands and agents come with the plugin or the
// kit; a skill can be taken on its own, pinned to the indexed commit.
const pinnedSkill =
  sub.kind === 'skill' && skill.commitSha
    ? 'mkdir -p .claude/skills/' + dirName + ' && curl -fsSL https://codeload.github.com/' + skill.repo + '/tar.gz/' + skill.commitSha +
      ' | tar -xz -C .claude/skills/' + dirName + ' --strip-components=' + (sub.slug.split('/').length + 1) + ' ' +
      skill.repo.split('/')[1] + '-' + skill.commitSha + '/' + sub.slug
    : null;
const metaDesc = tx(sub.description ?? skill.tagline).slice(0, 158);
---

<Base
  title={t.title(sub.name, skill.displayName)}
  description={metaDesc}
  ogImage={`/og/superteam/${skill.id}/${sub.slug}.png`}
>
  <section class="st-head">
    <div class="container">
      <nav class="st-breadcrumb" aria-label={d.breadcrumb}>
        <a href={l('/superteam')}>Superteam Brasil</a>
        <span aria-hidden="true">/</span>
        <a href={l(superteamPage(skill))}>{skill.displayName}</a>
        <span aria-hidden="true">/</span>
        <span>{sub.name}</span>
      </nav>
      <div class="st-badges">
        <span class="badge badge-st">Superteam Brasil · {m.common.official}</span>
        <span class="badge">{t.kind[sub.kind]}</span>
        <span class="badge">{skill.displayName}</span>
      </div>
      <h1 class="st-title mono">{sub.name}</h1>
      <div class="st-byline">
        <span>{d.byline}</span>
        <span aria-hidden="true">·</span>
        <a href={superteamGithubUrl(skill, sub.path)} target="_blank" rel="noopener">{skill.repo}/{sub.path}</a>
      </div>
      {sub.description && <p class="st-lead">{tx(sub.description)}</p>}
      <div style="margin-top:20px">
        <MdActions url={fileUrl} name={sub.name} />
      </div>
    </div>
  </section>

  <section class="st-body">
    <div class="container st-grid">
      <article>
        <div class="st-panel">
          {
            sub.kind === 'command' && (
              <>
                <p class="st-panel-note">
                  <Rich text={t.commandNote}>
                    <Fragment slot="skill">{skill.displayName}</Fragment>
                    <a slot="link" href={l(superteamPage(skill))}>{skill.displayName}</a>
                  </Rich>
                </p>
                <CopyBlock command={`/${sub.name}`} prompt={false} />
              </>
            )
          }
          {
            sub.kind === 'agent' && (
              <p class="st-panel-note">
                <Rich text={t.agentNote}>
                  <Fragment slot="skill">{skill.displayName}</Fragment>
                  <a slot="link" href={l(superteamPage(skill))}>{skill.displayName}</a>
                </Rich>
              </p>
            )
          }
          {
            sub.kind === 'skill' && pinnedSkill && (
              <>
                <p class="st-panel-note">{t.skillOnly}</p>
                <CopyBlock command={pinnedSkill} />
                <p class="st-panel-note">{t.skillSet}</p>
                {skill.install[0]?.commands.map((c) => <CopyBlock command={c} />)}
              </>
            )
          }
          <p class="st-panel-note">{t.noInstall}</p>
          <CopyBlock command={m.superteam.readPrompt(`${SITE_URL}${fileUrl}`)} prompt={false} />
        </div>

        <div class="st-section-title st-section-head">
          <h2>{sub.path.split('/').pop()}</h2>
          <MdActions url={fileUrl} name={sub.path} />
        </div>
        {
          Content ? (
            <div class="prose" id="skill-prose">
              <Content />
            </div>
          ) : (
            <p class="muted">
              <Rich text={t.notMirrored}>
                <a slot="link" href={superteamGithubUrl(skill, sub.path)} target="_blank" rel="noopener">{t.readOnGithub}</a>
              </Rich>
            </p>
          )
        }

        <nav class="st-kit-actions" aria-label={t.otherKind[sub.kind]} style="margin-top:40px">
          {prev && <a class="btn btn-ghost btn-sm" href={l(superteamPage(skill, prev))}>← {prev.name}</a>}
          {next && <a class="btn btn-ghost btn-sm" href={l(superteamPage(skill, next))}>{next.name} →</a>}
        </nav>

        <KitBand />
      </article>

      <aside class="st-aside">
        <div class="st-meta">
          <h3>{d.details}</h3>
          <dl>
            <div><dt>{t.partOf}</dt><dd><a href={l(superteamPage(skill))}>{skill.displayName}</a></dd></div>
            <div><dt>{t.type}</dt><dd>{t.kind[sub.kind]}</dd></div>
            <div><dt>{d.maintainer}</dt><dd>Superteam Brasil</dd></div>
            <div><dt>{d.license}</dt><dd>{skill.license ?? d.noLicense}</dd></div>
            {skill.tag && <div><dt>{d.release}</dt><dd>{skill.tag}</dd></div>}
            <div>
              <dt>{d.pinnedCommit}</dt>
              <dd><a class="mono" href={superteamGithubUrl(skill, sub.path)} target="_blank" rel="noopener">{skill.commitSha?.slice(0, 7)}</a></dd>
            </div>
          </dl>
        </div>
        {
          sub.files.length > 0 && (
            <div class="st-meta">
              <h3>{t.referenceFiles} ({sub.files.length})</h3>
              <FileLibrary skill={skill} paths={sub.files} base={sub.slug + '/'} open />
            </div>
          )
        }
        <div class="st-meta">
          <h3>{t.moreKind[sub.kind]} ({siblings.length})</h3>
          <div class="st-files">
            <ul>
              {siblings.map((x) => (
                <li>
                  <a href={l(superteamPage(skill, x))} aria-current={x.slug === sub.slug ? 'page' : undefined}>{x.name}</a>
                  <button type="button" class="st-file-copy" data-copy-url={superteamFileUrl(skill, x.path)} aria-label={m.common.copy.copyAsMarkdown(x.name)}>
                    <span class="md-label">{m.common.copy.md}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </section>
</Base>
