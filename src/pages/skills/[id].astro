---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CopyBlock from '../../components/CopyBlock.astro';
import { registry, installCommands, CATEGORY_LABELS, SITE_URL } from '../../lib/registry';
import { refsFor } from '../../lib/skill-refs';

export async function getStaticPaths() {
  const entries = await getCollection('skills');
  return registry.official.map((skill) => ({
    params: { id: skill.id },
    props: { skill, entry: entries.find((e) => e.id === skill.id) },
  }));
}

const { skill, entry } = Astro.props;
const { Content } = entry
  ? await render(entry)
  : { Content: null };
const install = installCommands(skill);
const companionFiles = skill.files.filter((f) => !f.endsWith('/'));
const readMinutes = Math.max(1, Math.round(skill.words / 220));
const refs = refsFor(skill.id);
---

<Base
  title={`${skill.title} — Solana Skills`}
  description={(skill.summary ?? skill.description).slice(0, 158).replace(/\s+\S*$/, '') + '…'}
  ogImage={`/og/skills/${skill.id}.png`}
>
  <section class="detail-head">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/skills">Skills</a>
        <span aria-hidden="true">/</span>
        <span>{skill.title}</span>
      </nav>
      <div class="badges">
        <span class="badge badge-official">Official</span>
        <span class="badge">{CATEGORY_LABELS[skill.category] ?? skill.category}</span>
        {skill.multiFile && <span class="badge">Multi-file</span>}
      </div>
      <h1>{skill.title}</h1>
      <div class="name-row">
        <code class="mono name-chip">{skill.name}</code>
        {skill.version && <span class="muted">v{skill.version}</span>}
        <span class="muted">·</span>
        <a class="muted repo-link" href={skill.githubUrl} target="_blank" rel="noopener"
          >{skill.repo}</a
        >
        <span class="muted">·</span>
        <a
          class="agent-view mono"
          href={skill.hostedPath}
          title="The raw SKILL.md this page renders — the URL to hand an agent"
          >Agent view ↗</a
        >
      </div>
      <p class="lead">{skill.summary ?? skill.description}</p>
      {
        skill.summary && (
          <details class="triggers">
            <summary>When your agent invokes this</summary>
            <p>{skill.description}</p>
          </details>
        )
      }
    </div>
  </section>

  <section class="detail-body">
    <div class="container detail-grid">
      <article>
        <div class="install-panel" data-tabs>
          <div class="tabs" role="tablist" aria-label="Install methods">
            <button class="tab" role="tab" id="tab-cli" aria-controls="panel-cli" data-tab="cli" aria-selected="true">skills CLI</button>
            <button class="tab" role="tab" id="tab-claude" aria-controls="panel-claude" data-tab="claude" aria-selected="false" tabindex="-1"
              >Claude Code</button
            >
            <button class="tab" role="tab" id="tab-nono" aria-controls="panel-nono" data-tab="nono" aria-selected="false" tabindex="-1"
              >No install</button
            >
            <button class="tab" role="tab" id="tab-git" aria-controls="panel-git" data-tab="git" aria-selected="false" tabindex="-1">Git</button>
          </div>
          <div class="tab-panel" role="tabpanel" id="panel-cli" aria-labelledby="tab-cli" tabindex="0" data-panel="cli">
            <p class="panel-note">
              One command for Claude Code, Cursor, Codex, Windsurf and other agents — pulls the
              full skill{skill.multiFile && ', companion files included'}.
            </p>
            <CopyBlock command={install.cli} />
          </div>
          <div class="tab-panel" role="tabpanel" id="panel-claude" aria-labelledby="tab-claude" tabindex="0" data-panel="claude" hidden>
            <p class="panel-note">
              Drop the hosted file into your skills directory. Global (all projects):
            </p>
            <CopyBlock command={install.claudeGlobal} />
            <p class="panel-note">Or scoped to the current project:</p>
            <CopyBlock command={install.claudeProject} />
            {
              skill.multiFile && (
                <p class="panel-hint">
                  This skill references companion files ({companionFiles.length} of them) — links
                  in the hosted copy resolve to GitHub, so it works standalone. For the full
                  offline bundle use the CLI or Git tab.
                </p>
              )
            }
          </div>
          <div class="tab-panel" role="tabpanel" id="panel-nono" aria-labelledby="tab-nono" tabindex="0" data-panel="nono" hidden>
            <p class="panel-note">
              The skill is hosted as plain markdown — tell your agent:
            </p>
            <CopyBlock
              prompt={false}
              command={`Read ${install.hosted} and follow it for this task: `}
            />
            <p class="panel-note">
              Or have the skills CLI generate a one-shot prompt (pipe it straight into your agent):
            </p>
            <CopyBlock command={`npx skills use ${skill.repo}@${skill.name} | claude`} />
            <p class="panel-note">Or pull the raw file into a terminal session:</p>
            <CopyBlock command={`curl -fsSL ${install.hosted}`} />
          </div>
          <div class="tab-panel" role="tabpanel" id="panel-git" aria-labelledby="tab-git" tabindex="0" data-panel="git" hidden>
            <p class="panel-note">
              Copy the skill directory{skill.multiFile && ' with all companion files'} straight
              from GitHub:
            </p>
            <CopyBlock command={install.git} />
          </div>
        </div>

        {
          refs.length > 0 && (
            <section class="ref-lib">
              <h2 class="contents-title">Reference library</h2>
              <p class="ref-sub muted">
                {refs.length} focused files, hosted here — point your agent at just the one it
                needs instead of the whole skill.
              </p>
              <div class="ref-grid">
                {refs.map((ref) => (
                  <a class="ref-card" href={`/s/${skill.id}/${ref.path}`}>
                    <span class="ref-title">{ref.title}</span>
                    {ref.description && <span class="ref-desc">{ref.description}</span>}
                    <code class="mono ref-path">{ref.path}</code>
                  </a>
                ))}
              </div>
            </section>
          )
        }

        <h2 class="contents-title">Skill contents</h2>
        <div class="prose" id="skill-prose">{Content && <Content />}</div>
      </article>

      <aside>
        <div class="meta-card">
          <h3>Hosted file</h3>
          <div class="hosted-row">
            <a class="mono hosted-url" href={skill.hostedPath}>{SITE_URL.replace('https://', '')}{skill.hostedPath}</a>
            <button class="copy-btn static" data-copy={install.hosted} aria-label="Copy hosted URL" title="Copy URL">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="9" y="9" width="13" height="13" rx="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
            </button>
          </div>

          <h3>Details</h3>
          <dl class="meta-list">
            <div>
              <dt>Maintainer</dt>
              <dd>Solana Foundation</dd>
            </div>
            <div>
              <dt>License</dt>
              <dd>{skill.license ?? 'None declared'}</dd>
            </div>
            {
              skill.version && (
                <div>
                  <dt>Version</dt>
                  <dd>{skill.version}</dd>
                </div>
              )
            }
            <div>
              <dt>Length</dt>
              <dd>{skill.words.toLocaleString('en-US')} words · ~{readMinutes} min</dd>
            </div>
            {
              skill.bytes && (
                <div>
                  <dt>Agent cost</dt>
                  <dd title="Approximate tokens an agent spends reading this (bytes ÷ 4)">
                    ~{Math.round(skill.bytes / 4 / 100) / 10}k tokens
                    {skill.refsBytes
                      ? ` (+${Math.round((skill.refsBytes / 4) * 1e-3)}k refs)`
                      : ''}
                  </dd>
                </div>
              )
            }
            {
              skill.pushedAt && (
                <div>
                  <dt>Repo updated</dt>
                  <dd>
                    <time datetime={skill.pushedAt}>
                      {new Date(skill.pushedAt + 'T00:00:00Z').toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                        timeZone: 'UTC',
                      })}
                    </time>
                  </dd>
                </div>
              )
            }
            {
              skill.commitSha && (
                <div>
                  <dt>Pinned commit</dt>
                  <dd
                    title={
                      skill.pinnedAt
                        ? `Pin taken ${skill.pinnedAt} — mirror, links, and installs all reference this exact commit`
                        : 'Mirror, links, and installs all reference this exact commit'
                    }
                  >
                    <a
                      class="mono sha-link"
                      href={`https://github.com/${skill.repo}/tree/${skill.commitSha}`}
                      target="_blank"
                      rel="noopener"
                    >
                      {skill.commitSha.slice(0, 7)}
                    </a>
                    {skill.commitDate && (
                      <>
                        {' · '}
                        <time datetime={skill.commitDate}>
                          {new Date(skill.commitDate).toLocaleDateString('en-US', {
                            year: 'numeric',
                            month: 'short',
                            day: 'numeric',
                            timeZone: 'UTC',
                          })}
                        </time>
                      </>
                    )}
                  </dd>
                </div>
              )
            }
            {
              skill.integrity?.['SKILL.md'] && (
                <div>
                  <dt>Integrity</dt>
                  <dd
                    class="mono"
                    title={`sha256 of the hosted SKILL.md — verify: curl -fsSL https://skills.solana.com${skill.hostedPath} | shasum -a 256`}
                  >
                    sha256:{skill.integrity['SKILL.md'].slice(0, 12)}…
                  </dd>
                </div>
              )
            }
            {
              /* Bot committers ([bot] logins) aren't meaningful attribution and
                 their /<login> profile URLs 404 — show real contributors only. */
              skill.lastAuthor && !skill.lastAuthor.endsWith('[bot]') && (
                <div>
                  <dt>Last updated by</dt>
                  <dd>
                    <a
                      class="inline-link"
                      href={`https://github.com/${skill.lastAuthor}`}
                      target="_blank"
                      rel="noopener"
                    >
                      @{skill.lastAuthor}
                    </a>
                  </dd>
                </div>
              )
            }
            {
              skill.compatibility && (
                <div>
                  <dt>Requires</dt>
                  <dd>{skill.compatibility.replace(/^Requires\s*/i, '')}</dd>
                </div>
              )
            }
          </dl>

          {
            companionFiles.length > 0 && (
              <details class="files-tree">
                <summary>
                  <h3>Companion files ({companionFiles.length})</h3>
                </summary>
                <ul class="mono">
                  {companionFiles.map((f) => {
                    const hostedHere = (skill.hostedFiles ?? []).includes(f);
                    return (
                      <li>
                        <a
                          href={
                            hostedHere
                              ? `/s/${skill.id}/${f}`
                              : `https://github.com/${skill.repo}/blob/${skill.commitSha ?? skill.branch}${skill.dir ? `/${skill.dir}` : ''}/${f}`
                          }
                          target={hostedHere ? undefined : '_blank'}
                          rel={hostedHere ? undefined : 'noopener'}
                          title={hostedHere ? 'Hosted here — stable URL for agents' : 'On GitHub'}
                        >
                          {f}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </details>
            )
          }

          <div class="meta-actions">
            <a class="btn btn-ghost btn-sm" href={skill.skillFileUrl} target="_blank" rel="noopener"
              >View on GitHub</a
            >
            <a
              class="btn btn-ghost btn-sm"
              href={`https://github.com/${skill.repo}/issues`}
              target="_blank"
              rel="noopener">Report issue</a
            >
          </div>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  // Copy buttons on every code block in the rendered skill.
  for (const pre of document.querySelectorAll('#skill-prose pre')) {
    const code = pre.textContent ?? '';
    const btn = document.createElement('button');
    btn.className = 'copy-btn pre-copy';
    btn.setAttribute('aria-label', 'Copy code block');
    btn.setAttribute('data-copy', code.trimEnd());
    btn.innerHTML =
      '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
    const wrap = document.createElement('div');
    wrap.className = 'pre-wrap';
    pre.replaceWith(wrap);
    wrap.append(pre, btn);
  }
</script>

<style is:global>
  .pre-wrap {
    position: relative;
  }
  .pre-wrap .pre-copy {
    position: absolute;
    top: 10px;
    right: 10px;
    transform: none;
    opacity: 0;
    transition: opacity 0.15s ease;
    background: rgba(0, 0, 0, 0.5);
  }
  .pre-wrap:hover .pre-copy,
  .pre-wrap .pre-copy:focus-visible,
  .pre-wrap .pre-copy.copied {
    opacity: 1;
  }
</style>

<style>
  .detail-head {
    padding: 48px 0 40px;
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(45% 100% at 80% 0%, rgba(20, 241, 149, 0.07), transparent 60%),
      radial-gradient(45% 100% at 10% 0%, rgba(153, 69, 255, 0.12), transparent 60%),
      var(--bg);
  }
  .breadcrumb {
    display: flex;
    gap: 10px;
    font-size: 0.86rem;
    color: var(--text-3);
    margin-bottom: 22px;
  }
  .breadcrumb a:hover {
    color: var(--green);
  }
  .badges {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
  }
  h1 {
    font-size: clamp(1.9rem, 4vw, 2.7rem);
  }
  .name-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
    flex-wrap: wrap;
  }
  .name-chip {
    font-size: 0.85rem;
    color: var(--green);
    background: rgba(20, 241, 149, 0.08);
    border: 1px solid rgba(20, 241, 149, 0.25);
    border-radius: 6px;
    padding: 3px 10px;
  }
  .repo-link:hover {
    color: var(--green);
  }
  .agent-view {
    font-size: 0.8rem;
    color: var(--green);
    border: 1px solid rgba(20, 241, 149, 0.3);
    border-radius: 999px;
    padding: 2px 11px;
    transition: all 0.15s ease;
  }
  .agent-view:hover {
    background: rgba(20, 241, 149, 0.1);
  }
  .lead {
    margin-top: 18px;
    color: var(--text-2);
    max-width: 76ch;
    font-size: 0.98rem;
  }
  .triggers {
    margin-top: 14px;
    max-width: 76ch;
  }
  .triggers summary {
    cursor: pointer;
    font-size: 0.84rem;
    color: var(--text-3);
    user-select: none;
    list-style: none;
  }
  .triggers summary::-webkit-details-marker {
    display: none;
  }
  .triggers summary::before {
    content: '▸ ';
    color: var(--green);
  }
  .triggers[open] summary::before {
    content: '▾ ';
  }
  .triggers summary:hover {
    color: var(--text-2);
  }
  .triggers p {
    margin-top: 10px;
    font-size: 0.86rem;
    color: var(--text-3);
    padding: 12px 16px;
    border-left: 2px solid var(--border-strong);
    background: var(--bg-elev);
    border-radius: 0 10px 10px 0;
  }
  .detail-body {
    padding-block: 44px 72px;
  }
  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 48px;
    align-items: start;
  }
  .install-panel {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
    padding: 6px 22px 22px;
  }
  .panel-note {
    color: var(--text-3);
    font-size: 0.88rem;
    margin: 16px 0 10px;
  }
  .panel-hint {
    color: var(--text-3);
    font-size: 0.82rem;
    margin-top: 12px;
    padding: 10px 14px;
    border-left: 2px solid var(--purple);
    background: rgba(153, 69, 255, 0.06);
    border-radius: 0 8px 8px 0;
  }
  .contents-title {
    margin: 44px 0 8px;
    font-size: 1.3rem;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }
  .ref-sub {
    font-size: 0.88rem;
    margin: 10px 0 18px;
  }
  .ref-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 10px;
  }
  .ref-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    transition: border-color 0.15s ease, background 0.15s ease;
    min-width: 0;
  }
  .ref-card:hover {
    border-color: rgba(20, 241, 149, 0.45);
    background: #12121a;
  }
  .ref-title {
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: -0.01em;
  }
  .ref-desc {
    font-size: 0.78rem;
    color: var(--text-3);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ref-path {
    font-size: 0.68rem;
    color: var(--green);
    opacity: 0.75;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  aside {
    position: sticky;
    top: calc(var(--header-h) + 24px);
  }
  .meta-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .meta-card h3 {
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-3);
    font-weight: 620;
    margin-top: 8px;
  }
  .meta-card h3:first-child {
    margin-top: 0;
  }
  .hosted-row {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-code);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 9px 12px;
  }
  .hosted-url {
    flex: 1;
    min-width: 0;
    font-size: 0.76rem;
    color: var(--green);
    word-break: break-all;
  }
  .copy-btn.static {
    position: static;
    transform: none;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
  }
  .meta-list {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .meta-list > div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 0.86rem;
  }
  .meta-list dt {
    color: var(--text-3);
    white-space: nowrap;
  }
  .meta-list dd {
    text-align: right;
    color: var(--text-2);
  }
  .files-tree summary {
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .files-tree summary::-webkit-details-marker {
    display: none;
  }
  .files-tree summary h3::after {
    content: ' +';
    color: var(--green);
  }
  .files-tree[open] summary h3::after {
    content: ' –';
  }
  .files-tree ul {
    list-style: none;
    padding: 10px 0 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
    max-height: 260px;
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .files-tree a {
    font-size: 0.74rem;
    color: var(--text-3);
    transition: color 0.12s ease;
  }
  .files-tree a:hover {
    color: var(--green);
  }
  .meta-actions {
    display: flex;
    gap: 10px;
    margin-top: 10px;
  }
  .sha-link {
    color: var(--text-2);
    border-bottom: 1px dashed var(--border-strong);
  }
  .sha-link:hover {
    color: var(--green);
  }
  @media (max-width: 980px) {
    .detail-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    article,
    aside {
      min-width: 0;
    }
    aside {
      position: static;
      order: -1;
    }
  }
</style>
