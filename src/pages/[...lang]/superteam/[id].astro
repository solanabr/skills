---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import MdActions from '../../../components/MdActions.astro';
import Rich from '../../../components/Rich.astro';
import KitBand from '../../../components/superteam/KitBand.astro';
import InstallPanel from '../../../components/superteam/InstallPanel.astro';
import FileLibrary from '../../../components/superteam/FileLibrary.astro';
import '../../../styles/superteam.css';
import {
  registry,
  SITE_URL,
  superteamPage,
  superteamFileUrl,
  superteamGithubUrl,
} from '../../../lib/registry';
import { categoryLabel, i18n, withLocales } from '../../../i18n';

export async function getStaticPaths() {
  const entries = await getCollection('stbr');
  return withLocales(
    registry.superteam.map((skill) => ({
      params: { id: skill.id },
      props: {
        skill,
        entry: skill.main ? entries.find((e) => e.id === `${skill.id}/${skill.main!.replace(/\.md$/, '')}`) : undefined,
      },
    })),
  );
}

const { skill, entry } = Astro.props;
const { m, l, date, tx } = i18n(Astro);
const t = m.superteam.skill;
const d = m.superteam.detail;
const { Content } = entry ? await render(entry) : { Content: null };
const mainUrl = skill.main ? superteamFileUrl(skill, skill.main) : null;
const KIND: Record<string, { title: string; sub: string }> = t.kinds;
const byKind = ['skill', 'command', 'agent']
  .map((k) => ({ kind: k, items: skill.subskills.filter((x) => x.kind === k) }))
  .filter((g) => g.items.length > 0);
const COUNT_LABEL: Record<string, string> = t.counts;
const pinDate = skill.commitDate ? date(skill.commitDate) : null;
---

<Base
  title={t.title(skill.displayName)}
  description={tx(skill.tagline)}
  ogImage={`/og/superteam/${skill.id}.png`}
>
  <section class="st-head">
    <div class="container">
      <nav class="st-breadcrumb" aria-label={d.breadcrumb}>
        <a href={l('/superteam')}>Superteam Brasil</a>
        <span aria-hidden="true">/</span>
        <span>{skill.displayName}</span>
      </nav>
      <div class="st-badges">
        <span class="badge badge-st">Superteam Brasil · {m.common.official}</span>
        <span class="badge">{categoryLabel(m, skill.category)}</span>
        <span class="badge">{skill.kitTier === 'core' ? t.corePack : t.addOnPack}</span>
      </div>
      <h1 class="st-title">{skill.displayName}</h1>
      <div class="st-byline">
        <span>{d.byline}</span>
        <span aria-hidden="true">·</span>
        <a href={skill.url} target="_blank" rel="noopener">{skill.repo}</a>
        {skill.tag && (<><span aria-hidden="true">·</span><span>{skill.tag}</span></>)}
        {skill.stars !== null && (<><span aria-hidden="true">·</span><span>★ {skill.stars}</span></>)}
      </div>
      <p class="st-lead">{tx(skill.tagline)} {tx(skill.summary)}</p>
      <p class="st-note">
        <Rich text={t.note}>
          <code slot="sha" class="mono">{skill.commitSha?.slice(0, 7)}</code>
        </Rich>
      </p>
      <dl class="st-stats">
        {
          Object.entries(skill.counts).map(([k, n]) => (
            <div>
              <dt>{COUNT_LABEL[k] ?? k}</dt>
              <dd>{n}</dd>
            </div>
          ))
        }
        <div><dt>{t.markdownFiles}</dt><dd>{skill.files.length}</dd></div>
      </dl>
    </div>
  </section>

  <section class="st-body">
    <div class="container st-grid">
      <article>
        <InstallPanel options={skill.install} fetchable={mainUrl ? SITE_URL + mainUrl : null} />

        {
          byKind.map((g) => (
            <section>
              <h2 class="st-section-title">
                {KIND[g.kind].title} ({g.items.length})
              </h2>
              <p class="st-section-sub">{KIND[g.kind].sub}</p>
              <div class="st-cards">
                {g.items.map((x) => (
                  <div class="st-card">
                    <a class="st-card-main" href={l(superteamPage(skill, x))}>
                      <span class="st-card-name">{x.name}</span>
                      {x.description && <span class="st-card-desc">{tx(x.description)}</span>}
                    </a>
                    <MdActions url={superteamFileUrl(skill, x.path)} name={x.name} size="sm" />
                  </div>
                ))}
              </div>
            </section>
          ))
        }

        {
          Content && skill.main && mainUrl && (
            <section>
              <div class="st-section-title st-section-head">
                <h2>{skill.main}</h2>
                <MdActions url={mainUrl} name={skill.main} />
              </div>
              <div class="prose" id="skill-prose">
                <Content />
              </div>
            </section>
          )
        }

        <KitBand />
      </article>

      <aside class="st-aside">
        <div class="st-meta">
          <h3>{d.details}</h3>
          <dl>
            <div><dt>{d.maintainer}</dt><dd>Superteam Brasil</dd></div>
            <div><dt>{t.aside.repository}</dt><dd><a href={skill.url} target="_blank" rel="noopener">{skill.repo}</a></dd></div>
            <div><dt>{d.license}</dt><dd>{skill.license ?? d.noLicense}</dd></div>
            {skill.tag && <div><dt>{d.release}</dt><dd>{skill.tag}</dd></div>}
            <div>
              <dt>{d.pinnedCommit}</dt>
              <dd>
                <a class="mono" href={`https://github.com/${skill.repo}/tree/${skill.commitSha}`} target="_blank" rel="noopener">{skill.commitSha?.slice(0, 7)}</a>
                {pinDate && ` · ${pinDate}`}
              </dd>
            </div>
            <div><dt>{t.aside.contributors}</dt><dd>{skill.contributors?.length ?? '—'}</dd></div>
            <div><dt>{t.aside.inKit}</dt><dd>{skill.kitTier === 'core' ? t.aside.kitCore : t.aside.kitAddOn}</dd></div>
          </dl>
          <div class="st-meta-actions">
            <a class="btn btn-ghost btn-sm" href={skill.url} target="_blank" rel="noopener">{t.aside.viewOnGithub}</a>
            <a class="btn btn-ghost btn-sm" href={`https://github.com/${skill.repo}/issues`} target="_blank" rel="noopener">{t.aside.reportIssue}</a>
          </div>
        </div>
        <div class="st-meta">
          <h3>{t.files.heading} ({skill.files.length})</h3>
          <p class="muted" style="font-size:0.8rem">
            <Rich text={t.files.body}>
              <code slot="path" class="mono">/s/{skill.id}/</code>
            </Rich>
          </p>
          <FileLibrary skill={skill} />
          {skill.main && (
            <a class="muted" style="font-size:0.78rem" href={superteamGithubUrl(skill, skill.main)} target="_blank" rel="noopener">
              {t.files.source}
            </a>
          )}
        </div>
      </aside>
    </div>
  </section>
</Base>
