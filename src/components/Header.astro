---
import SolanaMark from './SolanaMark.astro';

const nav: { href: string; label: string; short?: string; wide?: boolean }[] = [
  { href: '/skills', label: 'Skills' },
  { href: '/ecosystem', label: 'Ecosystem' },
  { href: '/superteam', label: 'Superteam Brasil', short: 'Superteam' },
  { href: '/#use', label: 'How it works', wide: true },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Solana Skills home">
      <SolanaMark size={24} />
      <span class="brand-name">Solana <span class="brand-thin">Skills</span></span>
    </a>
    <nav aria-label="Main">
      <ul class="nav-list">
        {
          nav.map((item) => (
            <li class:list={{ 'wide-only': item.wide }}>
              <a
                href={item.href}
                class:list={['nav-link', { active: path.startsWith(item.href) && item.href !== '/#use' }]}
              >
                {item.short ? (
                  <>
                    <span class="label-full">{item.label}</span>
                    <span class="label-short">{item.short}</span>
                  </>
                ) : (
                  item.label
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="header-actions">
      <a
        class="btn btn-ghost btn-sm"
        href="https://github.com/solana-foundation"
        target="_blank"
        rel="noopener"
      >
        <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
        GitHub
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    background: rgba(0, 0, 0, 0.72);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
  }
  .brand-name {
    font-weight: 660;
    font-size: 1.02rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .brand-thin {
    font-weight: 420;
    color: var(--text-2);
  }
  nav {
    flex: 1;
    min-width: 0;
  }
  .label-short {
    display: none;
  }
  .nav-list {
    display: flex;
    gap: 6px;
    list-style: none;
    padding: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .nav-link {
    display: inline-block;
    padding: 7px 13px;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 520;
    color: var(--text-2);
    white-space: nowrap;
    transition: all 0.15s ease;
  }
  .nav-link:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.06);
  }
  .nav-link.active {
    color: var(--text);
    background: rgba(255, 255, 255, 0.08);
  }
  @media (max-width: 640px) {
    .header-inner {
      gap: 14px;
    }
    .header-actions {
      display: none;
    }
    .nav-link {
      padding: 7px 9px;
      font-size: 0.85rem;
    }
    .label-full {
      display: none;
    }
    .label-short {
      display: inline;
    }
  }
  /* Phones: the three sections fit without scrolling; "How it works" is an
     anchor on the homepage. */
  @media (max-width: 480px) {
    .wide-only,
    .brand-thin {
      display: none;
    }
  }
</style>
